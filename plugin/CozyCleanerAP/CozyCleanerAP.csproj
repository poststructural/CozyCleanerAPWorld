<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CozyCleanerAP</AssemblyName>
    <RootNamespace>CozyCleanerAP</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;NU1701;MSB3277</NoWarn>
    <!-- Override with: dotnet build -p:GameDir="D:\Games\Cozy Cleaner\" -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\Cozy Cleaner\</GameDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)..\..\tools\downloads\bepinex_win\BepInEx\core\</BepInExCore>
    <ManagedDir>$(GameDir)Cozy Cleaner_Data\Managed\</ManagedDir>
    <ReleaseDir Condition="'$(ReleaseDir)' == ''">$(MSBuildThisFileDirectory)..\..\release\</ReleaseDir>
  </PropertyGroup>

  <!-- Compile against the GAME's own (stripped) mscorlib/System/System.Core so any BCL member the game
       build stripped is a compile error here instead of a MissingMethodException at runtime. -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- All game assemblies (the game code references many of them for type resolution). -->
    <Reference Include="$(ManagedDir)*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToRelease" AfterTargets="Build">
    <MakeDir Directories="$(ReleaseDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseDir)" />
  </Target>

</Project>
